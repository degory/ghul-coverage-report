namespace Coverage.Output is
    use Collections.LIST;

    class TOTALS_DTO(lines_covered: int, lines_valid: int, branches_covered: int, branches_valid: int);

    class METHOD_DTO(
        name: string, file: string, start_line: int,
        lines_covered: int, lines_valid: int, branches_covered: int, branches_valid: int
    );

    class TYPE_DTO(
        name: string, file: string, start_line: int,
        lines_covered: int, lines_valid: int, branches_covered: int, branches_valid: int,
        methods: LIST[METHOD_DTO]
    );

    class NAMESPACE_DTO(
        name: string,
        lines_covered: int, lines_valid: int, branches_covered: int, branches_valid: int,
        types: LIST[TYPE_DTO]
    );

    class SUMMARY_DTO(totals: TOTALS_DTO, namespaces: LIST[NAMESPACE_DTO]);

    // One entry per source file report_writer wrote a page for - every
    // `.ghul` file under the project's source root, not just the ones that
    // made it into a Cobertura report. `measured` is false for a file no
    // suite ever instrumented, distinct from a file that was instrumented
    // and simply never executed (measured=true, lines_covered=0) - the
    // site renders the two differently rather than treating an unmeasured
    // file as 0% covered.
    class FILE_LIST_ENTRY_DTO(path: string, lines_covered: int, lines_valid: int, measured: bool);

    class LINE_DTO(number: int, text: string, hits: int?, branch_covered: int?, branch_total: int?);

    // Mirrors ghul-dev's example-data WIRE_SEMANTIC_TOKEN shape (1-based
    // line/column, VS Code semantic-token vocabulary) so the site's ported
    // GhulExample.vue merge logic needs no adaptation.
    class TOKEN_DTO(start_line: int, start_column: int, end_line: int, end_column: int, token_type: string, modifiers: string);

    // Mirrors ghul-dev's example-data WIRE_HOVER_ENTRY shape.
    class HOVER_DTO(start_line: int, start_column: int, end_line: int, end_column: int, description: string, kind_label: string?);

    class FILE_DTO(path: string, lines: LIST[LINE_DTO], semantic_tokens: LIST[TOKEN_DTO], hovers: LIST[HOVER_DTO]);

    // shields.io "endpoint" badge schema (https://shields.io/badges/endpoint-badge)
    // — a README badge points `img.shields.io/endpoint?url=` at this file
    // wherever it's deployed, giving a badge in the same visual style as
    // shields.io's own badges (matching the rest of a repo's README)
    // without generating an SVG ourselves.
    class BADGE_DTO(schema_version: int, label: string, message: string, color: string);
si
