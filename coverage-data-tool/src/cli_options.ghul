namespace CoverageDataTool is
    class CLI_OPTIONS(
        reports_pattern: string,
        project_directory: string,
        target_directory: string,
        source_prefix: string,
        // Where the coverage history lives - a checkout of the report repo's
        // `coverage-history` branch. Absent means don't record history, which
        // is what a local run wants.
        history_directory: string?,
        // Where to write the run's markdown coverage summary. In CI this is
        // $GITHUB_STEP_SUMMARY.
        summary_path: string?,
        // The commit of the project being measured, which is what a
        // regression has to be attributed to. The tool can't read it: the
        // project directory is a second checkout it only ever reads source
        // from.
        measured_commit: string?,
        history_keep: int
    ) is
        // `-reports:` accepts `;`-separated glob patterns (matching
        // ReportGenerator's own convention); `-sourceprefix:` is the
        // directory, relative to `-project:`, that Cobertura's `filename`
        // attributes are relative to (ghūl's own pipeline instruments from
        // `src/`, hence that default).
        parse(arguments: string[]) -> CLI_OPTIONS? static is
            let reports: string? mut;
            let project: string? mut;
            let target: string? mut;
            let history: string? mut;
            let summary: string? mut;
            let commit: string? mut;
            let source_prefix mut = "src";
            let keep mut = 100;

            for arg in arguments do
                if arg.starts_with("-reports:") then
                    reports = arg.substring("-reports:".length);
                elif arg.starts_with("-project:") then
                    project = arg.substring("-project:".length);
                elif arg.starts_with("-targetdir:") then
                    target = arg.substring("-targetdir:".length);
                elif arg.starts_with("-sourceprefix:") then
                    source_prefix = arg.substring("-sourceprefix:".length);
                elif arg.starts_with("-historydir:") then
                    history = arg.substring("-historydir:".length);
                elif arg.starts_with("-summary:") then
                    summary = arg.substring("-summary:".length);
                elif arg.starts_with("-measuredcommit:") then
                    commit = arg.substring("-measuredcommit:".length);
                elif arg.starts_with("-historykeep:") then
                    keep = int.parse(arg.substring("-historykeep:".length));
                fi
            od

            if !reports? \/ !project? \/ !target? then
                return null;
            fi

            return CLI_OPTIONS(
                reports, project, target, source_prefix,
                history, summary, commit, keep
            );
        si
    si
si
